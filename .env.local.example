# Copia este archivo a .env.local (para probar en tu computador)
# y carga las mismas variables en Vercel -> Settings -> Environment Variables

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (gratis, sin tarjeta) — para las fotos de los platos.
# Ver el README, sección "Cloudinary", para obtener estos dos valores.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Nombre del restaurant (opcional, se muestra en el encabezado)
NEXT_PUBLIC_RESTAURANT_NAME="Rincón El Sauce"
